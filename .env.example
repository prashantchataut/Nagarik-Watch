# ---------------------------------------------------------------------------
# नागरिक वाच (Nagarik Watch) — environment template
# Copy to .env (local) / set in Vercel → Project → Settings → Environment Variables
# ---------------------------------------------------------------------------

# --- Database (required) ----------------------------------------------------
# Local dev: SQLite file (created automatically by `pnpm db:push`).
# Production (Vercel): use Postgres — Neon / Vercel Postgres / Supabase.
#   1) switch provider in apps/web/prisma/schema.prisma: sqlite → postgresql
#   2) set DATABASE_URL to the pooled connection string
#   3) run `pnpm db:push`
DATABASE_URL="file:./db/dev.db"

# --- Site identity (SEO) ----------------------------------------------------
# Canonical origin used for metadata, sitemap, RSS, OG tags.
# Without this the launch check stays at 94% (operator item).
NEXT_PUBLIC_SITE_URL="https://nagarikwatch.com"

# --- Cloudflare R2 media storage (uploads) ----------------------------------
# R2 dashboard → Manage API Tokens → create token with Object Read & Write.
# Bucket → Settings → Public access (r2.dev or custom domain).
# Without these, /api/uploads answers 501 with setup guidance and the site
# keeps working with local/desk artwork (launch check operator item).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="nagarik-watch-media"
R2_PUBLIC_BASE_URL=""   # e.g. https://media.nagarikwatch.com or https://pub-xxxx.r2.dev
