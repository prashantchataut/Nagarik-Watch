# Nagarik Watch — environment variables.
# Copy to `.env` (or `.env.local`) and fill in real values. Never commit real secrets.
# Apps fail fast at boot if a required var is missing/invalid (packages/db/src/env.ts).

# ----------------------------------------------------------------------------
# Database (PostgreSQL) — used by Payload CMS
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/nagarikwatch?schema=public"
NW_DB_POOL_MAX="10"
ENGAGEMENT_DB_POOL_MAX="5"
NEWSLETTER_DB_POOL_MAX="5"
SUBMISSIONS_DB_POOL_MAX="5"

# ----------------------------------------------------------------------------
# Payload CMS
# ----------------------------------------------------------------------------
PAYLOAD_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Public URL of the CMS/admin app
PAYLOAD_PUBLIC_SERVER_URL="http://localhost:3001"
PAYLOAD_ADMIN_URL="http://localhost:3001/admin"
# Server-side token for the web app to read protected Payload endpoints when required.
PAYLOAD_API_TOKEN=""
# Public CMS URL used by browser-safe links only.
NEXT_PUBLIC_PAYLOAD_URL="http://localhost:3001"

# ----------------------------------------------------------------------------
# Web app (Next.js)
# ----------------------------------------------------------------------------
# Public URL of the reader-facing site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional public production URL used by auth providers.
BETTER_AUTH_URL="http://localhost:3000"
# Auth/session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
# HMAC-shared secret signing the publish -> revalidate webhook (web + admin share it)
REVALIDATE_SECRET="change-me-to-a-long-random-string"

# ----------------------------------------------------------------------------
# Reader-facing site config
# ----------------------------------------------------------------------------
# Launch status: "preview" shows a visible readiness banner; "live" hides it only when blockers are cleared.
NEXT_PUBLIC_LAUNCH_STATUS="preview"
# Minimum editorial inventory enforced when launch status is switched to live.
LAUNCH_MIN_PUBLISHED_ARTICLES="30"
LAUNCH_MIN_CATEGORIES_WITH_CONTENT="15"
LAUNCH_MIN_LEAD_READY_ARTICLES="6"
# Content source: "payload" reads the live CMS via the Local API (prod, needs DB);
# any other value uses the JSON article store, which starts empty and shows honest empty states.
PAYLOAD_CONTENT_SOURCE=""
# Preferred switch for the reader application: seed | payload | json.
# Keep "seed" until a reachable production CMS is configured.
CONTENT_SOURCE="seed"
# Public publisher identity. Fill these before setting NEXT_PUBLIC_LAUNCH_STATUS="live".
NEXT_PUBLIC_PUBLICATION_NAME="Nagarik Watch"
NEXT_PUBLIC_PUBLICATION_LEGAL_NAME=""
NEXT_PUBLIC_EDITOR_IN_CHIEF=""
NEXT_PUBLIC_NEWSROOM_PHONE=""
NEXT_PUBLIC_NEWSROOM_EMAIL="newsroom@nagarikwatch.com"
NEXT_PUBLIC_NEWSROOM_ADDRESS="Kathmandu, Nepal"
# Department of Information & Broadcasting (DoIB) publication-registration number.
NEXT_PUBLIC_DOIB_NUMBER=""
# Keep the web app admin scaffold disabled in production unless server-side auth guards are wired.
ENABLE_WEB_ADMIN_SCAFFOLD=""

# ----------------------------------------------------------------------------
# Newsroom admin (Better Auth) — first-boot credentials
# On the first process boot after DATABASE_URL is reachable, getAuth() seeds a
# super_admin account from these. Repeated boots are no-ops (the account
# exists → signUp conflict → skip). After first login, change the password in
# the admin UI, then clear NEWSROOM_ADMIN_PASSWORD here so it can't be reused.
# Without these set, there is no way to reach /admin/* — signup only creates
# 'reader' accounts and requireNewsroomSession() rejects readers.
# ----------------------------------------------------------------------------
NEWSROOM_SUPERADMIN_EMAIL="owner@nagarikwatch.com"
NEWSROOM_SUPERADMIN_PASSWORD=""
NEWSROOM_SUPERADMIN_NAME="Newsroom Owner"
NEWSROOM_ADMIN_EMAIL="editor@nagarikwatch.com"
NEWSROOM_ADMIN_PASSWORD=""
NEWSROOM_ADMIN_NAME="Newsroom Admin"

# ----------------------------------------------------------------------------
# Object storage adapter (ADR-003) — default: S3-compatible (Cloudflare R2)
# Swap endpoint/account to use AWS S3, Backblaze B2, MinIO, Bunny, etc.
# ----------------------------------------------------------------------------
STORAGE_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="nagarikwatch-media"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL="https://media.nagarikwatch.com"

# ----------------------------------------------------------------------------
# Edge / CDN adapter (ADR-003) — default: Cloudflare
# Used for cache purge on publish. Leave blank to use a no-op adapter in dev.
# ----------------------------------------------------------------------------
EDGE_PROVIDER="cloudflare"          # cloudflare | aws | bunny | none
EDGE_API_TOKEN=""
EDGE_ZONE_ID=""

# ----------------------------------------------------------------------------
# Analytics (Phase 1)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="nagarikwatch.com"
NEXT_PUBLIC_PLAUSIBLE_SRC="https://plausible.io/js/script.js"
NEXT_PUBLIC_GA4_ID=""

# ----------------------------------------------------------------------------
# Web push (Phase 3) — OneSignal or FCM
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ONESIGNAL_APP_ID=""
ONESIGNAL_REST_API_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@nagarikwatch.com"

# ----------------------------------------------------------------------------
# Newsletter (Phase 3) — Listmonk or Buttondown
# ----------------------------------------------------------------------------
NEWSLETTER_PROVIDER=""
NEWSLETTER_API_KEY=""
NEWSLETTER_API_BASE=""

# ----------------------------------------------------------------------------
# Ad environment
# ----------------------------------------------------------------------------
# off = collapse slots, house = labelled direct-sale slots, network = reserve network containers.
NEXT_PUBLIC_ADS_MODE="off"
# Example values: adsense | gam. Required when NEXT_PUBLIC_ADS_MODE="network".
NEXT_PUBLIC_AD_NETWORK=""
NEXT_PUBLIC_ADSENSE_CLIENT=""

# ----------------------------------------------------------------------------
# Live data providers (all optional until real providers are contracted)
# Providers must return attributed, timestamped data. When a provider is not
# configured or unavailable, widgets show an honest unavailable/empty state;
# production never invents scores, prices, alerts, or market values.
# ----------------------------------------------------------------------------
# Weather. Omit WEATHER_PROVIDER (or set "open-meteo") for the keyless feed.
# Supported keyed providers: meteosource | openweather | weatherstack
WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=""
# Alternate weather keys (set WEATHER_PROVIDER to the matching name to use one).
OPENWEATHER_API_KEY=""
WEATHERSTACK_API_KEY=""

AQI_PROVIDER="open-meteo-air-quality"
AQI_API_KEY=""
DISASTER_ALERT_PROVIDER="manual-cms-or-official-feed"
DISASTER_ALERT_API_KEY=""
# Optional official/vendor JSON endpoint. Without it, the service uses USGS
# earthquake data filtered to Nepal plus verified manual newsroom overrides.
DISASTER_ALERT_API_URL=""
NEPSE_PROVIDER="licensed-vendor-required"
NEPSE_API_KEY=""
GOLD_SILVER_PROVIDER="licensed-vendor-required"
GOLD_SILVER_API_KEY=""
# Forex. Omit FOREX_PROVIDER (or set "nr-bank") for the keyless NRB daily feed.
# Supported keyed provider: fxrateapis
FOREX_PROVIDER="nr-bank"
FOREX_API_KEY=""
SPORTS_PROVIDER="licensed-sports-api"
SPORTS_API_KEY=""
# Football live scores. Supported free-tier provider: football-data-org
FOOTBALL_PROVIDER=""
FOOTBALL_API_KEY=""
# Cricket live scores (incl. Nepal matches when available). Supported free-tier provider: api-sports
CRICKET_PROVIDER=""
CRICKET_API_KEY=""
CRICKET_API_BASE="https://v1.cricket.api-sports.io"
ELECTION_PROVIDER="official-election-commission-or-manual-cms"
ELECTION_API_KEY=""
EXAM_RESULTS_PROVIDER="neb-official-or-manual-cms"
EXAM_RESULTS_API_KEY=""
YOUTUBE_PROVIDER="youtube-data-api"
YOUTUBE_API_KEY=""
PARLIAMENT_LIVE_URL=""
LIVE_WIDGET_CACHE_TTL_SECONDS="300"

# ----------------------------------------------------------------------------
# Email, push, media and storage provider placeholders
# ----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_PROVIDER_API_KEY=""
PUSH_NOTIFICATION_KEY=""
CLOUDINARY_URL=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# ----------------------------------------------------------------------------
# Anti-spam / bot checks
# ----------------------------------------------------------------------------
CAPTCHA_PROVIDER="turnstile"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# ----------------------------------------------------------------------------
# Reader membership, submissions, payments, and operational integrations
# ----------------------------------------------------------------------------
PAID_MEMBER_EMAILS=""
PAYMENT_PROVIDER=""
STRIPE_SECRET_KEY=""
SUBMISSION_IP_SALT="replace-with-a-random-secret"
NEXT_PUBLIC_AD_SALES_EMAIL="ads@nagarikwatch.com"
NEPSE_API_URL=""
SMTP_HOST=""
BLOB_READ_WRITE_TOKEN=""
S3_BUCKET=""
