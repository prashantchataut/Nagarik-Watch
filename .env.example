# ---------------------------------------------------------------------------
# नागरिक वाच (Nagarik Watch) — environment template
# Copy to .env (local) / set in Vercel → Project → Settings → Environment Variables
# ---------------------------------------------------------------------------

# --- Database (required) ----------------------------------------------------
# Aiven Postgres — single source of truth for NextAuth + Prisma.
# Local and Vercel both use postgresql://... (Aiven requires sslmode=require).
# Get it from Aiven console → your project → Connection string (pooled if available).
DATABASE_URL="postgresql://user:password@pg-xxx.aivencloud.com:XXXX/defaultdb?sslmode=require"

# --- Site identity (SEO) ----------------------------------------------------
# Canonical origin used for metadata, sitemap, RSS, OG tags.
# Without this the launch check stays at 94% (operator item).
NEXT_PUBLIC_SITE_URL="https://nagarikwatch.com"

# --- Object storage — Void Drive (S3-compatible) ------------------------------
# Void Drive dashboard → API Keys → create key with Object Read & Write.
# Without these, /api/uploads answers 501 and the site keeps working with local media.
STORAGE_ENDPOINT=""          # e.g. https://gateway.voiddrive.com or https://s3.void.example.com
STORAGE_BUCKET="nagarik-watch-media"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""   # e.g. https://media.nagarikwatch.com or https://pub-xxx.r2.dev (no trailing slash)

# Legacy R2 vars (still read as fallback) — prefer STORAGE_* above
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="nagarik-watch-media"
# R2_PUBLIC_BASE_URL=""
