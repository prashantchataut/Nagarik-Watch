# ---------------------------------------------------------------------------
# नागरिक वाच (Nagarik Watch) — environment template
# Copy to .env.local (apps/web) or set in Vercel → Settings → Environment Variables.
#
# Grouped by what breaks without it:
#   REQUIRED TO BOOT      — the app refuses to start or 500s without these
#   REQUIRED FOR LAUNCH   — the launch gate stays red without these
#   OPTIONAL              — a feature degrades honestly; the site still works
#
# A fresh clone needs nothing at all: with no CONTENT_SOURCE and no CMS origin
# the reader is served from the local desk store, so `pnpm build` succeeds.
# ---------------------------------------------------------------------------

# === REQUIRED TO BOOT ======================================================

# Auth signing secret. Better Auth (not NextAuth) throws at module load in
# production when this is missing or shorter than 32 chars, which 500s every
# page, not just /auth. Generate: openssl rand -base64 32
AUTH_SECRET=""
# BETTER_AUTH_SECRET is read as an alias; set either one.
# BETTER_AUTH_SECRET=""

# Postgres. Runtime reads go through a raw `pg` pool (Prisma is only used by the
# seed/cleanup scripts). Aiven requires sslmode=require.
# Without it the site still renders, but every operational feature — comments,
# bookmarks, rate limits, notifications, ops health — degrades to no-op.
DATABASE_URL="postgresql://user:password@pg-xxx.aivencloud.com:XXXX/defaultdb?sslmode=require"

# === REQUIRED FOR LAUNCH ===================================================

# Canonical origin for metadata, sitemap, RSS, OG tags and CSRF origin checks.
# Must match the host that actually serves the app (see docs/launch-runbook.md).
NEXT_PUBLIC_SITE_URL="https://nagarikwatch.com"

# Auth origin used for CSRF/trusted-origin checks and cookie scope. Defaults to
# NEXT_PUBLIC_SITE_URL when unset. Set it explicitly when the login host differs
# from the canonical reading host (for example an apex → www redirect).
# BETTER_AUTH_URL="https://nagarikwatch.com"

# Which store serves the reader: "json" (local desk store) or "payload"
# (remote Payload CMS). Unset resolves from configuration — Payload when an
# origin below is set, the desk store otherwise. An explicit "payload" without
# an origin is refused at boot rather than silently serving stale JSON.
# Per docs/env-launch-checklist.md, flip json → payload last, after migration.
CONTENT_SOURCE="json"
# PAYLOAD_PUBLIC_SERVER_URL="https://cms.nagarikwatch.com"
# PAYLOAD_ADMIN_URL="https://cms.nagarikwatch.com/admin"
# PAYLOAD_API_TOKEN=""
# PAYLOAD_SECRET=""                     # apps/admin signing secret (32+ chars)
# PAYLOAD_DB_PUSH="false"               # false in production: run migrations
# BLOB_READ_WRITE_TOKEN=""              # durable media uploads (apps/admin)

# Bearer token for /api/cron/* — must be at least 32 chars or the GitHub
# ops-crons workflow refuses to run. Generate: openssl rand -hex 32
CRON_SECRET=""

# Bearer token for /api/revalidate (on-demand ISR purge from the CMS).
REVALIDATE_SECRET=""

# Cloudflare Turnstile — gates contact, news tips and poll votes. Without both
# keys those endpoints reject writes rather than accepting unverified ones.
# CAPTCHA_PROVIDER="turnstile"          # "turnstile" | "" (disabled)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Publication identity shown in the masthead, imprint and structured data.
NEXT_PUBLIC_PUBLICATION_NAME="नागरिक वाच"
NEXT_PUBLIC_DOIB_NUMBER=""            # Dept. of Information registration no.
NEXT_PUBLIC_PUBLICATION_LEGAL_NAME="" # registered company/publisher name
NEXT_PUBLIC_EDITOR_IN_CHIEF=""        # named editor in the imprint
NEXT_PUBLIC_NEWSROOM_ADDRESS=""
NEXT_PUBLIC_NEWSROOM_PHONE=""
NEXT_PUBLIC_NEWSROOM_EMAIL=""
NEXT_PUBLIC_CORRECTIONS_EMAIL=""
NEXT_PUBLIC_NEWS_TIP_EMAIL=""

# "preview" until the desk signs off; "live" turns the launch gate strict.
NEXT_PUBLIC_LAUNCH_STATUS="preview"

# The launch gate stays red below this many published articles (default 30).
# LAUNCH_MIN_PUBLISHED_ARTICLES="30"
# PUBLISHED_ARTICLE_COUNT=""            # declared count when the source is unread

# Public first path segments for desks added after the build (see
# apps/web/lib/public-path-allowlist.ts). Without one of these, an unknown
# top-level URL is a real 404, which is what crawlers expect.
# NEXT_PUBLIC_EXTRA_PUBLIC_SEGMENTS=""  # comma separated, e.g. "climate,health"
# NEXT_PUBLIC_PERMISSIVE_PUBLIC_SEGMENTS="false"
#   "true" lets any slug-shaped first segment through to the App Router (for a
#   fully CMS-managed taxonomy). Unknown URLs then answer 200 + noindex.

# Static export preview (Cloudflare Pages). Never set on the Node launch origin.
# NEXT_PUBLIC_STATIC_EXPORT="0"

# === OPTIONAL — object storage ==============================================
# Without these, uploads answer 501 and the site keeps working with local media.
# The configured public base URL is also added to the CSP img/media sources.
STORAGE_ENDPOINT=""          # e.g. https://gateway.voiddrive.com
STORAGE_BUCKET="nagarik-watch-media"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""   # e.g. https://media.nagarikwatch.com (no trailing slash)
# Legacy R2 names are still read as a fallback: R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, R2_BUCKET, R2_PUBLIC_BASE_URL, R2_ENDPOINT.

# === OPTIONAL — sign-in providers ===========================================
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="true"
# Require TOTP for newsroom accounts.
# STAFF_MFA_ENABLED="true"
# Extra origins allowed to post credentials (comma separated).
# AUTH_TRUSTED_ORIGINS=""

# === OPTIONAL — web push ====================================================
# Generate: pnpm exec web-push generate-vapid-keys
# NEXT_PUBLIC_WEB_PUSH_VAPID_KEY=""
# WEB_PUSH_VAPID_PRIVATE_KEY=""
# WEB_PUSH_SUBJECT="mailto:desk@nagarikwatch.com"

# === OPTIONAL — email / newsletter =========================================
# RESEND_API_KEY=""
# NEWSLETTER_FROM="नागरिक वाच <desk@nagarikwatch.com>"
# AUTH_EMAIL_FROM="नागरिक वाच <no-reply@nagarikwatch.com>"
# Self-hosted newsletter API (alternative to Resend). Both are required together
# or the digest composer reports "email-adapter-disabled" instead of sending.
# NEWSLETTER_API_KEY=""
# NEWSLETTER_API_BASE=""
# Set true only when the desk wants the morning digest auto-sent, not drafted.
# DIGEST_SEND_NOW="false"

# === OPTIONAL — advertising =================================================
# "off" (default) | "house" | "network". Ad-tech origins enter the CSP only in
# network mode with complete credentials — see lib/security/response-headers.ts.
# NEXT_PUBLIC_ADS_MODE="off"
# NEXT_PUBLIC_AD_NETWORK=""            # "adsense" | "gam"
# NEXT_PUBLIC_ADSENSE_CLIENT=""        # AdSense needs client AND slot
# NEXT_PUBLIC_ADSENSE_SLOT=""
# NEXT_PUBLIC_GAM_NETWORK_CODE=""      # GAM needs the network code
# NEXT_PUBLIC_AD_SALES_EMAIL=""
# ADS_TXT_BODY=""                      # served verbatim at /ads.txt
# SELLERS_JSON_BODY=""                 # served verbatim at /sellers.json

# === OPTIONAL — analytics and monitoring ====================================
# Self-hosted Plausible origins are read from NEXT_PUBLIC_PLAUSIBLE_SRC and
# allowed in the CSP automatically.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="nagarikwatch.com"
# NEXT_PUBLIC_PLAUSIBLE_SRC="https://plausible.io/js/script.js"
# NEXT_PUBLIC_GA4_ID=""
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# === OPTIONAL — live data providers =========================================
# Each provider falls back to "unavailable" rather than inventing numbers.
# WEATHER_PROVIDER="open-meteo"
# WEATHER_API_KEY=""
# NEPSE_API_URL=""
# GOLD_SILVER_API_URL=""
# CALENDAR_PROVIDER=""
# CALENDAR_API_URL=""
# CALENDAR_API_KEY=""
# CRICKET_PROVIDER=""
# CRICKET_API_KEY=""
# FOOTBALL_PROVIDER=""
# FOOTBALL_API_KEY=""
# DISASTER_ALERT_API_URL=""

# === OPTIONAL — AI, TTS and semantic search =================================
# Every one of these degrades honestly when unset: extractive summaries stay
# local, article audio stays off, and search stays lexical (BM25).
# AI_PROVIDER_KEY=""                   # LLM rewrite path; OPENAI_API_KEY is read as an alias
# TTS_PROVIDER=""
# TTS_PROVIDER_KEY=""                  # TTS_API_KEY is read as an alias
# SEMANTIC_SEARCH_PROVIDER=""          # hosted ANN; SEMANTIC_SEARCH_URL is an alias
# SEMANTIC_SEARCH_API_KEY=""

# === OPTIONAL — payments / membership =======================================
# PAYMENT_PROVIDER=""                  # "stripe" when configured
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_MONTHLY_PRICE_ID=""
# STRIPE_YEARLY_PRICE_ID=""
# NEXT_PUBLIC_MEMBERSHIP_PUBLIC="false"

# === OPTIONAL — e-paper and partner feeds ===================================
# EPAPER_ENABLED="false"
# PARTNER_FEED_TOKENS=""               # comma separated
# PARTNER_FEED_EMBARGO_MINUTES="15"

# === OPTIONAL — local dev / first boot ======================================
# Boot accounts created by the seed and newsroom scripts. Never set in
# production: rotate these before any shared environment.
# NEWSROOM_ADMIN_EMAIL=""
# NEWSROOM_ADMIN_PASSWORD=""
# NEWSROOM_SUPERADMIN_EMAIL=""
# NEWSROOM_SUPERADMIN_PASSWORD=""
# "true" lets a fresh Postgres run its auth migrations on first boot instead of
# failing closed. Leave unset in production and run migrations deliberately.
# AUTH_AUTO_MIGRATE="false"
# "true" seeds the starter corpus on an empty store. Never on a live newsroom.
# ALLOW_STARTER_SEED="false"

# === OPTIONAL — tuning ======================================================
# Aiven's shared tiers cap connections; keep the per-instance pool small.
# NW_DB_POOL_MAX="1"
# NW_DB_CONNECT_TIMEOUT_MS="8000"
# NW_PAYLOAD_READ_TIMEOUT_MS="8000"
# Managed Postgres with a private CA chain: "false" accepts the provider chain
# (Aiven/Neon style) instead of failing the TLS handshake.
# DATABASE_SSL_REJECT_UNAUTHORIZED=""
# Salt for hashing submitter IPs in the tips store. Generate a random value.
# SUBMISSION_IP_SALT=""
# EXPERIMENT_HASH_SECRET=""
