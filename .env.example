# Nagarik Watch — environment variables.
# Copy to `.env` (or `.env.local`) and fill in real values. Never commit real secrets.
# Apps fail fast at boot if a required var is missing/invalid (packages/db/src/env.ts).

# ----------------------------------------------------------------------------
# Database (PostgreSQL) — Payload, Better Auth, and durable operational state
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/nagarikwatch?schema=public"
# Apply versioned ops tables before production traffic: pnpm migrate:ops
# The web app enforces one connection per warm Vercel instance.
# Dev-only persistent Better Auth database when DATABASE_URL is omitted.
PGLITE_DATA_DIR=".data/auth-pglite"
# Set false only when migrations are applied separately during deployment.
AUTH_AUTO_MIGRATE="true"
# Local-only durable files used when Postgres is intentionally omitted.
LIVE_MANUAL_STORE_PATH=".data/live-manual.json"
LIVE_BLOG_STORE_PATH=".data/live-blogs.json"
CONTACT_STORE_PATH=".data/contact-messages.json"
POLLS_STORE_PATH=".data/polls.json"
NEWSLETTER_DB_POOL_MAX="5"
SUBMISSIONS_DB_POOL_MAX="5"

# ----------------------------------------------------------------------------
# Payload CMS
# ----------------------------------------------------------------------------
# Canonical content source for the reader app.
# Use `payload` in production once Payload CMS is deployed (see ADR-014).
CONTENT_SOURCE="json"
PAYLOAD_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Public URL of the CMS/admin app
PAYLOAD_PUBLIC_SERVER_URL="http://localhost:3001"
PAYLOAD_ADMIN_URL="http://localhost:3001/admin"
# Server-side API key for a least-privilege Payload service account.
# Required only for the journalist desk to create drafts through Payload REST.
# Grant that account article-create access; do not expose this value to browsers.
PAYLOAD_API_TOKEN=""
# Public CMS URL used by browser-safe links only.
NEXT_PUBLIC_PAYLOAD_URL="http://localhost:3001"
# Local schema push only. Set false in production and apply checked-in migrations.
PAYLOAD_DB_PUSH="true"

# ----------------------------------------------------------------------------
# Web app (Next.js)
# ----------------------------------------------------------------------------
# Public URL of the reader-facing site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional public production URL used by auth providers.
BETTER_AUTH_URL="http://localhost:3000"
# Auth/session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
# HMAC-shared secret signing the publish -> revalidate webhook (web + admin share it)
REVALIDATE_SECRET="change-me-to-a-long-random-string"
# Optional separate HMAC secret for anonymizing experiment visitor keys.
# Falls back to AUTH_SECRET when omitted.
EXPERIMENT_HASH_SECRET=""
# JSON array of experiment definitions. Keep empty until a reviewed experiment is ready.
# Wired client IDs: home-layout-v1 (homepage exposure), article-completion-v1 (read completion).
# Example:
# [{"id":"home-layout-v1","label":"Homepage layout","status":"active","primaryMetric":"article_completion","minimumExposuresPerVariant":200,"winnerProbability":0.95,"variants":[{"id":"control","label":"Control","weight":1},{"id":"treatment","label":"Treatment","weight":1}]},{"id":"article-completion-v1","label":"Article completion","status":"active","primaryMetric":"article_completion","minimumExposuresPerVariant":200,"winnerProbability":0.95,"variants":[{"id":"control","label":"Control","weight":1},{"id":"treatment","label":"Treatment","weight":1}]}]
EXPERIMENTS_JSON=""
# Operational analytics retention. `pnpm --filter @nagarikwatch/web retention:ops`
# reports eligible rows by default; pass --execute to delete. Comments are never included.
RETENTION_RANKING_DAYS="90"
RETENTION_SEARCH_DAYS="90"
RETENTION_EXPERIMENT_DAYS="180"
RETENTION_AD_DAYS="180"
RETENTION_RATE_LIMIT_DAYS="7"
# Comma-separated newsroom-reviewed lexical moderation terms. Do not put secrets here.
COMMENT_BANNED_WORDS=""

# ----------------------------------------------------------------------------
# Reader-facing site config
# ----------------------------------------------------------------------------
# Launch status still drives the admin /admin/launch checklist. Public pages never show it.
NEXT_PUBLIC_LAUNCH_STATUS="preview"
# When true and Better Auth Google is configured, public login shows an active Google button.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"
# Server-side Better Auth credentials. The public button remains disabled unless
# the feature flag and both credentials are present.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Minimum editorial inventory enforced when launch status is switched to live.
LAUNCH_MIN_PUBLISHED_ARTICLES="30"
LAUNCH_MIN_CATEGORIES_WITH_CONTENT="15"
LAUNCH_MIN_LEAD_READY_ARTICLES="6"
# Deployment-provided count used only by the launch-readiness dashboard.
PUBLISHED_ARTICLE_COUNT="0"
# Content source: "payload" reads the separately deployed CMS through its public REST API.
# Any other value uses the JSON/seed-backed store. Prefer payload once the CMS is live.
PAYLOAD_CONTENT_SOURCE="" # Legacy alias; prefer CONTENT_SOURCE.
# Preferred switch: json for local/preview; payload when admin CMS is ready.
CONTENT_SOURCE="json"
# Public publisher identity. Fill these before setting NEXT_PUBLIC_LAUNCH_STATUS="live".
NEXT_PUBLIC_PUBLICATION_NAME="Nagarik Watch"
NEXT_PUBLIC_PUBLICATION_LEGAL_NAME="Nagarik Watch Media Pvt. Ltd. (placeholder — verify before launch)"
NEXT_PUBLIC_EDITOR_IN_CHIEF="Editorial Board (placeholder — name before launch)"
NEXT_PUBLIC_NEWSROOM_PHONE="+977-1-0000000 (placeholder)"
NEXT_PUBLIC_NEWSROOM_EMAIL="newsroom@nagarikwatch.com"
NEXT_PUBLIC_NEWSROOM_ADDRESS="Kathmandu, Nepal (placeholder — registered office required)"
# Department of Information & Broadcasting (DoIB) publication-registration number.
NEXT_PUBLIC_DOIB_NUMBER="PENDING-REPLACE-BEFORE-LAUNCH"
# Enables the role-gated web operations dashboard. Content editing redirects to Payload
# whenever CONTENT_SOURCE=payload, preventing a shadow content store.
ENABLE_WEB_ADMIN_SCAFFOLD=""

# ----------------------------------------------------------------------------
# Newsroom admin (Better Auth) — first-boot credentials
# On the first process boot after DATABASE_URL is reachable, getAuth() seeds a
# super_admin account from these. Repeated boots are no-ops (the account
# exists → signUp conflict → skip). After first login, change the password in
# the admin UI, then clear NEWSROOM_ADMIN_PASSWORD here so it can't be reused.
# Without these set, there is no way to reach /admin/* — signup only creates
# 'reader' accounts and requireNewsroomSession() rejects readers.
# ----------------------------------------------------------------------------
NEWSROOM_SUPERADMIN_EMAIL="owner@nagarikwatch.com"
NEWSROOM_SUPERADMIN_PASSWORD=""
NEWSROOM_SUPERADMIN_NAME="Newsroom Owner"
NEWSROOM_ADMIN_EMAIL="editor@nagarikwatch.com"
NEWSROOM_ADMIN_PASSWORD=""
NEWSROOM_ADMIN_NAME="Newsroom Admin"
# Local-only deterministic accounts (never use these passwords in production).
NEWSROOM_REPORTER_EMAIL="reporter@local.test"
NEWSROOM_REPORTER_PASSWORD="local-reporter-only"
NEWSROOM_REPORTER_NAME="Local Reporter"
NEWSROOM_EDITOR_EMAIL="editor@local.test"
NEWSROOM_EDITOR_PASSWORD="local-editor-only"
NEWSROOM_EDITOR_NAME="Local Editor"
NEWSROOM_PUBLISHER_EMAIL="publisher@local.test"
NEWSROOM_PUBLISHER_PASSWORD="local-publisher-only"
NEWSROOM_PUBLISHER_NAME="Local Publisher"
# Local filesystem media when BLOB_READ_WRITE_TOKEN is empty (see apps/web/.data/uploads/).
LOCAL_MEDIA_DIR=".data/uploads"
# After changing NEWSROOM_*_PASSWORD in Vercel, set true for one deploy so boot
# re-hashes credential accounts, then set back to false.
AUTH_BOOT_SYNC_PASSWORD="false"

# ----------------------------------------------------------------------------
# Object storage adapter — official Payload Vercel Blob plugin.
# Provision Blob on the `nagarik-watch-admin` Vercel project; Vercel injects
# BLOB_READ_WRITE_TOKEN. Client uploads bypass the serverless body-size limit.
# ----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""
# Optional explicit Blob public origin for Next/Image. Example:
# https://<store-id>.public.blob.vercel-storage.com
STORAGE_PUBLIC_BASE_URL=""

# ----------------------------------------------------------------------------
# Edge / CDN adapter (ADR-003) — default: Cloudflare
# Used for cache purge on publish. Leave blank to use a no-op adapter in dev.
# ----------------------------------------------------------------------------
EDGE_PROVIDER="cloudflare"          # cloudflare | aws | bunny | none
EDGE_API_TOKEN=""
EDGE_ZONE_ID=""

# ----------------------------------------------------------------------------
# Analytics (Phase 1)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="nagarikwatch.com"
NEXT_PUBLIC_PLAUSIBLE_SRC="https://plausible.io/js/script.js"
NEXT_PUBLIC_GA4_ID=""
# No-op by default. "beacon" posts identifier-free metrics to /api/rum only
# after the reader grants analytics consent.
NEXT_PUBLIC_RUM_ADAPTER=""

# ----------------------------------------------------------------------------
# Web push
# In-app alerts work without these values. Background browser push requires:
# Generate once with: pnpm exec web-push generate-vapid-keys
# Keep the private key server-only. Subject must be mailto: or https:.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_WEB_PUSH_VAPID_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:newsroom@nagarikwatch.com"
# Vercel sends this bearer token when invoking protected cron routes.
CRON_SECRET="replace-with-a-random-secret"

# ----------------------------------------------------------------------------
# Newsletter (Phase 3) — Listmonk or Buttondown
# ----------------------------------------------------------------------------
NEWSLETTER_PROVIDER=""
NEWSLETTER_API_KEY=""
NEWSLETTER_API_BASE=""
# Sender identity accepted by the configured provider. Verify the domain before production.
NEWSLETTER_FROM="Nagarik Watch <newsletter@nagarikwatch.com>"
AUTH_EMAIL_FROM="Nagarik Watch <accounts@nagarikwatch.com>"

# ----------------------------------------------------------------------------
# Ad environment
# ----------------------------------------------------------------------------
# off = collapse slots, house = labelled direct-sale slots, network = reserve network containers.
NEXT_PUBLIC_ADS_MODE="off"
# Example values: adsense | gam. Required when NEXT_PUBLIC_ADS_MODE="network".
NEXT_PUBLIC_AD_NETWORK=""
NEXT_PUBLIC_ADSENSE_CLIENT=""
# Optional shared AdSense slot id used by network units when mode=network.
NEXT_PUBLIC_ADSENSE_SLOT=""
# Google Ad Manager network code (e.g. 123456789). Required when NEXT_PUBLIC_AD_NETWORK=gam.
NEXT_PUBLIC_GAM_NETWORK_CODE=""
# Real ads.txt seller declarations, one record per line. Leave empty while ads are off/house-only.
ADS_TXT_BODY=""

# ----------------------------------------------------------------------------
# Live data providers (all optional until real providers are contracted)
# Providers must return attributed, timestamped data. When a provider is not
# configured or unavailable, widgets show an honest unavailable/empty state;
# production never invents scores, prices, alerts, or market values.
# ----------------------------------------------------------------------------
# Weather. Omit WEATHER_PROVIDER (or set "open-meteo") for the keyless feed.
# Supported keyed providers: meteosource | openweather | weatherstack
WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=""
# Alternate weather keys (set WEATHER_PROVIDER to the matching name to use one).
OPENWEATHER_API_KEY=""
WEATHERSTACK_API_KEY=""

AQI_PROVIDER="open-meteo-air-quality"
AQI_API_KEY=""
DISASTER_ALERT_PROVIDER="manual-cms-or-official-feed"
DISASTER_ALERT_API_KEY=""
# Optional official/vendor JSON endpoint. Without it, the service uses USGS
# earthquake data filtered to Nepal plus verified manual newsroom overrides.
DISASTER_ALERT_API_URL=""
NEPSE_PROVIDER="licensed-vendor-required"
NEPSE_API_KEY=""
GOLD_SILVER_PROVIDER="licensed-vendor-required"
GOLD_SILVER_API_KEY=""
# Forex. Omit FOREX_PROVIDER (or set "nr-bank") for the keyless NRB daily feed.
# Supported keyed provider: fxrateapis
FOREX_PROVIDER="nr-bank"
FOREX_API_KEY=""
SPORTS_PROVIDER="licensed-sports-api"
SPORTS_API_KEY=""
# Football live scores. Supported free-tier provider: football-data-org
FOOTBALL_PROVIDER=""
FOOTBALL_API_KEY=""
# Cricket live scores (incl. Nepal matches when available). Supported free-tier provider: api-sports
CRICKET_PROVIDER=""
CRICKET_API_KEY=""
CRICKET_API_BASE="https://v1.cricket.api-sports.io"
ELECTION_PROVIDER="official-election-commission-or-manual-cms"
ELECTION_API_KEY=""
EXAM_RESULTS_PROVIDER="neb-official-or-manual-cms"
EXAM_RESULTS_API_KEY=""
YOUTUBE_PROVIDER="youtube-data-api"
YOUTUBE_API_KEY=""
PARLIAMENT_LIVE_URL=""
LIVE_WIDGET_CACHE_TTL_SECONDS="300"

# ----------------------------------------------------------------------------
# Email, push, media and storage providers
# ----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_PROVIDER_API_KEY=""
CLOUDINARY_URL=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# ----------------------------------------------------------------------------
# Anti-spam / bot checks
# ----------------------------------------------------------------------------
# Turnstile remains disabled unless the public site key and secret are non-empty.
CAPTCHA_PROVIDER="turnstile"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ----------------------------------------------------------------------------
# Staff multi-factor authentication
# ----------------------------------------------------------------------------
# Better Auth encrypted TOTP is wired. Set true in production; newsroom users
# are redirected to /auth/mfa/setup until enrollment is verified.
# Apply schema first: pnpm --filter @nagarikwatch/web migrate:auth
STAFF_MFA_ENABLED="false"
# ----------------------------------------------------------------------------
# Reader membership, submissions, payments, and operational integrations
# ----------------------------------------------------------------------------
# Option A (2026-07-19): keep false. Public site stays free-to-read + ads.
# Set true only when ready to expose /membership, paywall notices, and meters.
NEXT_PUBLIC_MEMBERSHIP_PUBLIC="false"
PAID_MEMBER_EMAILS=""
PAYMENT_PROVIDER=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring Stripe Price IDs offered by the membership checkout (dormant while public flag is false).
STRIPE_MONTHLY_PRICE_ID=""
STRIPE_YEARLY_PRICE_ID=""
SUBMISSION_IP_SALT="replace-with-a-random-secret"
NEXT_PUBLIC_AD_SALES_EMAIL="ads@nagarikwatch.com"
NEPSE_API_URL=""

# Authenticated partner feed controls. Comma-separated opaque bearer tokens.
PARTNER_FEED_TOKENS=""
PARTNER_FEED_EMBARGO_MINUTES="0"

# Optional local semantic blend. This is deterministic local term-vector math,
# not a claim of a hosted vector-search provider.
SEARCH_SEMANTIC_LOCAL="0"
# Hosted ANN / vendor semantic search (optional). Local BM25 remains production search.
SEMANTIC_SEARCH_PROVIDER=""
SEMANTIC_SEARCH_API_KEY=""

# Observability — thin boundary logs until @sentry/nextjs is installed against this DSN.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Editorial AI / TTS. Extractive drafts work without keys. LLM/TTS stay disabled until set.
AI_PROVIDER_KEY=""
TTS_PROVIDER=""
TTS_PROVIDER_KEY=""

# First-party e-paper remains disabled until a real config file is mounted.
EPAPER_ENABLED="false"
EPAPER_CONFIG_PATH=""

# ----------------------------------------------------------------------------
# Managed runtime variables — documented here, normally set by CI/hosting
# ----------------------------------------------------------------------------
# NODE_ENV, NEXT_PHASE, CI and VERCEL_URL/VERCEL_BRANCH_URL/
# VERCEL_PROJECT_PRODUCTION_URL are supplied by Next.js, CI, or Vercel.
# Do not hard-code them in committed environment files.
