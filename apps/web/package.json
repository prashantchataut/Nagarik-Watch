{
  "name": "@nagarikwatch/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy --minify",
    "deploy:free": "node scripts/cf-deploy-free.mjs",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "migrate:ops": "tsx scripts/migrate-ops.ts",
    "migrate:auth": "tsx scripts/migrate-auth.ts",
    "retention:ops": "tsx scripts/ops-retention.ts",
    "clean": "rimraf .next .turbo .open-next .wrangler"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@nagarikwatch/db": "workspace:*",
    "@nagarikwatch/ui": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.1",
    "@vercel/blob": "^2.6.1",
    "better-auth": "^1.6.23",
    "kysely": "^0.29.2",
    "next": "15.5.18",
    "pg": "^8.22.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.3.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nagarikwatch/tsconfig": "workspace:*",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.112.0"
  }
}
