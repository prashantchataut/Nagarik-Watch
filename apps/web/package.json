{
  "name": "@nagarikwatch/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy --minify",
    "deploy:free": "node scripts/cf-deploy-free.mjs",
    "build:pages": "node scripts/build-pages-static.mjs",
    "deploy:pages": "node scripts/build-pages-static.mjs --deploy",
    "restore:stash": "node scripts/restore-pages-stash.mjs",
    "configure:admin": "node scripts/configure-admin-env.mjs",
    "secrets:admin": "node scripts/push-admin-secrets.mjs",
    "deploy:app": "node scripts/deploy-app-worker.mjs",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:encoding": "node scripts/check-mojibake.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "migrate:ops": "tsx scripts/migrate-ops.ts",
    "migrate:auth": "tsx scripts/migrate-auth.ts",
    "retention:ops": "tsx scripts/ops-retention.ts",
    "clean": "rimraf .next .turbo .open-next .wrangler"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@nagarikwatch/db": "workspace:*",
    "@nagarikwatch/ui": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.1",
    "@vercel/blob": "^2.6.1",
    "better-auth": "^1.6.23",
    "kysely": "^0.29.2",
    "next": "15.5.18",
    "pg": "^8.22.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.3.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nagarikwatch/tsconfig": "workspace:*",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
