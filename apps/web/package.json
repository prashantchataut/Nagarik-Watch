{
  "name": "@nagarikwatch/web",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "algorithms:wiring": "node scripts/generate-algorithm-wiring.mjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "seed": "tsx scripts/seed_auth.ts && tsx scripts/seed_full.ts",
    "postinstall": "prisma generate",
    "migrate:ops": "tsx scripts/migrate-ops.ts",
    "migrate:auth": "tsx scripts/migrate-auth.ts",
    "retention:ops": "tsx scripts/ops-retention.ts",
    "check:encoding": "node scripts/check-mojibake.mjs",
    "clean": "rimraf .next .turbo .open-next .wrangler",
    "build:pages": "node scripts/build-pages-static.mjs",
    "deploy:pages": "node scripts/build-pages-static.mjs --deploy",
    "restore:stash": "node scripts/restore-pages-stash.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy --minify",
    "deploy:free": "node scripts/cf-deploy-free.mjs",
    "deploy:app": "node scripts/deploy-app-worker.mjs",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "configure:admin": "node scripts/configure-admin-env.mjs",
    "secrets:admin": "node scripts/push-admin-secrets.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@nagarikwatch/db": "workspace:*",
    "@nagarikwatch/ui": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.1",
    "@sentry/nextjs": "^10.70.0",
    "@vercel/blob": "^2.6.1",
    "astronomy-engine": "^2.1.19",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "kysely": "^0.29.2",
    "nepali-datetime": "^2.0.0",
    "next": "^16.1.1",
    "pg": "^8.22.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.10.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8.5.18",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.6"
  },
  "description": "नागरिक वाच (Nagarik Watch) — Devanagari-first news portal for Nepal."
}
