{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm --filter @nagarikwatch/admin generate:importmap && pnpm --filter @nagarikwatch/admin build",
  "devCommand": "pnpm --filter @nagarikwatch/admin dev",
  "installCommand": "cd ../.. && node scripts/verify-canonical-workspaces.mjs && pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "github": {
    "silent": true
  }
}
