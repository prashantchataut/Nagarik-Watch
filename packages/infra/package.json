    "test:watch": "vitest --passWithNoTests",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@nagarikwatch/db": "workspace:*"
  },
  "devDependencies": {
    "@nagarikwatch/tsconfig": "workspace:*",
    "@types/node": "^26.1.1",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
