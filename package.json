{
  "name": "nagarik-watch",
  "version": "2.0.0",
  "private": true,
  "description": "नागरिक वाच (Nagarik Watch) — a modern, Devanagari-first web news portal for Nepal.",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "node scripts/ci-build.mjs",
    "build:turbo": "turbo run build",
    "deploy": "node scripts/cf-ci-deploy.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && turbo run lint",
    "lint:fix": "eslint . --fix && turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format-changed.mjs",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @nagarikwatch/web exec vitest run lib/content/payload-source.contract.test.ts lib/content/content-source.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:newsroom": "playwright test --config=playwright.newsroom.config.ts",
    "test:e2e:admin": "playwright test --config=playwright.admin.config.ts",
    "dev:stack": "node scripts/dev-stack.mjs",
    "dev:newsroom": "node scripts/dev-newsroom.mjs",
    "validate:newsroom": "node scripts/validate-newsroom-env.mjs",
    "db:reset:test": "node scripts/db-reset-test.mjs",
    "test:a11y": "playwright test e2e/a11y.spec.ts --project=desktop-chromium",
    "clean": "turbo run clean && rimraf node_modules",
    "audit:public": "node scripts/audit-public-surface.mjs",
    "verify:launch": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm verify:static && pnpm --filter @nagarikwatch/web build && pnpm --filter @nagarikwatch/db test",
    "audit:ads": "node scripts/audit-ad-placements.mjs",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "audit:routes": "node scripts/route-matrix.mjs",
    "audit:internal-links": "node scripts/internal-links.mjs",
    "audit:ui-bans": "node scripts/audit-ui-bans.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:design-tokens": "node scripts/audit-design-tokens.mjs",
    "audit:font-budget": "node scripts/audit-font-budget.mjs",
    "audit:live-ux": "node scripts/audit-live-ux.mjs",
    "launch:gate": "node scripts/launch-gate.mjs",
    "launch:gate:live": "NEXT_PUBLIC_LAUNCH_STATUS=live node scripts/launch-gate.mjs",
    "launch:origin": "node scripts/assert-launch-origin.mjs",
    "verify:static": "pnpm verify:workspaces && pnpm verify:repo-invariants && pnpm verify:lockfile && pnpm verify:overrides && pnpm audit:script-refs && pnpm audit:e2e-coverage && pnpm audit:env-docs && pnpm audit:payload-routes && pnpm audit:public && pnpm audit:ads && pnpm audit:architecture && pnpm audit:ui-bans && pnpm audit:contrast && pnpm audit:design-tokens && pnpm audit:font-budget && pnpm audit:internal-links && pnpm launch:origin && pnpm launch:gate",
    "verify:lockfile": "node scripts/verify-workspace-lock.mjs",
    "verify:overrides": "node scripts/verify-lockfile-overrides.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "perf:budget:test": "node scripts/perf-budget.mjs --self-test",
    "migrate:ops": "pnpm --filter @nagarikwatch/web migrate:ops",
    "migrate:desk-to-payload": "tsx scripts/migrate-desk-to-payload.ts",
    "build:web": "pnpm verify:workspaces && pnpm --filter @nagarikwatch/web... build",
    "build:admin": "pnpm verify:workspaces && pnpm --filter @nagarikwatch/admin... build",
    "deploy:web:cf": "pnpm --filter @nagarikwatch/web deploy:app",
    "deploy:web:static": "pnpm --filter @nagarikwatch/web deploy:pages",
    "build:web:pages": "pnpm --filter @nagarikwatch/web build:pages",
    "build:cf-pages": "node scripts/cf-pages-build.mjs",
    "deploy:cf-pages": "node scripts/cf-pages-deploy.mjs",
    "preview:web:cf": "pnpm --filter @nagarikwatch/web preview",
    "verify:deploy": "pnpm verify:lockfile && pnpm build:web && pnpm build:admin",
    "verify:workspaces": "node scripts/verify-canonical-workspaces.mjs",
    "verify:repo-invariants": "node scripts/verify-repo-invariants.mjs",
    "start": "pnpm --filter ./apps/web start",
    "db:push": "pnpm --filter ./apps/web db:push",
    "seed": "pnpm --filter ./apps/web seed",
    "audit:env-docs": "node scripts/audit-env-docs.mjs",
    "audit:payload-routes": "node scripts/audit-payload-routes.mjs",
    "audit:script-refs": "node scripts/audit-script-refs.mjs",
    "audit:e2e-coverage": "node scripts/audit-e2e-coverage.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@nagarikwatch/tsconfig": "workspace:*",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.15.0",
    "next": "^16.1.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.68.0",
    "wrangler": "^4.112.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "~5.9.3",
      "next>postcss": "^8.5.18",
      "payload>undici": "^7.29.0",
      "miniflare>sharp": "^0.35.4",
      "vitest>vite": "^6.4.3",
      "deepmerge-ts": "^8.0.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr"
      ]
    }
  }
}
