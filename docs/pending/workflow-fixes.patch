diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index f0ca78b..ea343ac 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -33,6 +33,9 @@ jobs:
       - name: Verify workspace lockfile
         run: node scripts/verify-workspace-lock.mjs
 
+      - name: Verify lockfile overrides
+        run: node scripts/verify-lockfile-overrides.mjs
+
       - name: Install
         run: pnpm install --frozen-lockfile
 
diff --git a/.github/workflows/ops-crons.yml b/.github/workflows/ops-crons.yml
index 8b347ec..e5cbbd3 100644
--- a/.github/workflows/ops-crons.yml
+++ b/.github/workflows/ops-crons.yml
@@ -60,8 +60,16 @@ jobs:
             echo "CRON_SECRET repo secret missing or shorter than 32 chars."
             exit 1
           fi
-          base="${CRON_BASE_URL:-https://www.nagarikwatch.com}"
+          # `www.nagarikwatch.com` has no DNS record; only the apex is served.
+          # Defaulting to the www host made every scheduled run fail on a name
+          # resolution error rather than on anything about the cron itself.
+          base="${CRON_BASE_URL:-https://nagarikwatch.com}"
           base="${base%/}"
+          host="${base#*://}"; host="${host%%/*}"
+          if ! getent hosts "$host" > /dev/null 2>&1; then
+            echo "::error::Cron base host '${host}' does not resolve. Set the CRON_BASE_URL repo secret to the deployed origin."
+            exit 1
+          fi
           for job in $JOBS; do
             path="/api/cron/${job}"
             echo "POST ${base}${path}"
