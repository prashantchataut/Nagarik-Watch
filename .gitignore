# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
out/
dist/
build/
*.tsbuildinfo

# Turbo / cache
.turbo/

# Testing
coverage/
playwright-report/
test-results/

# Env — never commit real secrets. .env.example IS committed as documentation.
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Payload / CMS runtime
apps/admin/src/payload-types.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Agent workspace — per-session context, not project code.
# Project skills are reusable workflow code and may be committed.
.opencode/*
!.opencode/skills/
!.opencode/skills/**/
!.opencode/skills/**/SKILL.md

# Graphify knowledge graph outputs
graphify-out/

# Local dev artifacts: live HTML/CSS dumps saved for inspection, not part of the app
live-home.html
live.css

# Windows reserved device name (accidentally created by some tools)
nul

.vercel

# Local persistent development data
.data/

# Retired legacy CMS path. The canonical Payload app is apps/admin.
# This does not remove an already tracked folder; run: git rm -r apps/cms
apps/cms/
